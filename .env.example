# Required for live builds. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# Passcode for the login screen. Required in production; live builds are refused without it.
APP_PASSCODE=

# Optional: separate secret for signing the session cookie (defaults to APP_PASSCODE).
SESSION_SECRET=

# Optional tuning
SMEDJAN_MODEL=claude-opus-5-5
# low | medium | high — lower is faster to first byte
SMEDJAN_EFFORT=low
# 1 = fast mode (research preview, ~2.5x output speed, premium pricing)
SMEDJAN_FAST=0
